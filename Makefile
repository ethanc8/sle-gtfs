# CTrail Shore Line East GTFS build pipeline. See llm_notes/SPEC.md for the
# full design.
#
# Directory roles:
#   sources/     raw inputs, never written to by this Makefile
#   extracted/   timetable data pulled from the PDFs, hand-verified against
#                the rendered PDFs before being trusted (see UPDATING.md)
#   build/       everything generated by this Makefile (gitignored)

PIXI := pixi run --

# cargo needs a writable registry cache; keep it inside the repo instead of ~/.cargo.
export CARGO_HOME := $(CURDIR)/.cargo-home

.PHONY: all render-pdfs extract-draft build validate test check-new-schedules clean

all: test build validate

# Unit tests for the trickiest logic in gtfs_builder (grid/column detection,
# time parsing and midnight rollover, the exception-calendar suppression
# logic) and schedule_watcher (both run offline -- gtfs_builder's PDF tests
# read from sources/, schedule_watcher's page-parsing tests read from its
# own references/ snapshot, neither hits the network).
test:
	$(PIXI) pytest gtfs_builder
	cargo test --manifest-path schedule_watcher/Cargo.toml

# Render every source PDF page to PNG so timetable extraction can be checked
# by eye.
render-pdfs:
	mkdir -p build/pdf-preview
	$(PIXI) python gtfs_builder/render_pdfs.py --out-dir build/pdf-preview

# Regenerate DRAFT timetable CSVs from the PDFs listed in config.toml's
# [[revision]] list. Never overwrites the reviewed extracted/*.csv files
# directly -- output goes to extracted/*.draft.csv so manual corrections
# already promoted into extracted/*.csv aren't silently clobbered.
extract-draft:
	$(PIXI) python -m gtfs_builder.pdf_extract --out-dir extracted

# Build the GTFS feed from extracted/ + gtfs_builder/config.toml.
build:
	mkdir -p build/gtfs
	$(PIXI) python -m gtfs_builder.build_gtfs --out-dir build/gtfs --zip build/sle-gtfs.zip

# Round-trip parse the built feed with the Rust gtfs-structures crate and
# check referential integrity, stop-time ordering, and the exception/standing
# calendar-suppression invariant.
validate: build
	cargo run --manifest-path validator/Cargo.toml -- build/sle-gtfs.zip


# Check shorelineeast.com/schedules/ (network access required) for schedule
# PDF links not already present anywhere under sources/. Exits nonzero if
# any are found -- see schedule_watcher/README.md.
check-new-schedules:
	cargo run --manifest-path schedule_watcher/Cargo.toml -- check --sources-dir sources

clean:
	rm -rf build
